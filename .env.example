# このファイルを .env にコピーして実際の値を記入する（.env は Git 管理外）。
# systemd の EnvironmentFile= でも読み込めるよう、値と同じ行にはコメントを書かないこと。

INFLUXDB_URL=http://influxdb.example.local:8086
INFLUXDB_ORG=your-org
INFLUXDB_TOKEN=your-write-token
INFLUXDB_BUCKET=your-bucket

# --- 任意 ---
# InfluxDB へ記録する間隔（秒）
# SWITCHBOT_INTERVAL_SECONDS=10
# この秒数以上受信できていないデバイスは記録しない
# SWITCHBOT_STALE_SECONDS=300
# この秒数のあいだどのデバイスからも受信できなければ、エラーで終了する（0 で無効）
# SWITCHBOT_WATCHDOG_SECONDS=600
# デバイス定義ファイルの場所（既定: スクリプトと同じディレクトリの devices.toml。無くても動作する）
# SWITCHBOT_DEVICES_FILE=/opt/switchbot/devices.toml
# 1 にするとデバッグログを出力する
# SWITCHBOT_DEBUG=1
# 0 にすると devices.toml に書いた温湿度計だけを記録する（既定は 1。近所の温湿度計まで記録してしまうときに使う）
# SWITCHBOT_RECORD_UNKNOWN=1

# SwitchBot API のトークンとシークレット（アプリの「プロフィール > 設定 > アプリバージョンを10回タップ > 開発者向けオプション」で確認）
# 設定すると、アプリで付けた名前を device_name に使う
# SWITCHBOT_API_TOKEN=
# SWITCHBOT_API_SECRET=
# 名前を取得し直す間隔（秒）
# SWITCHBOT_NAME_REFRESH_SECONDS=21600

# InfluxDB に書き込めなかったデータを保存するファイル（既定: スクリプトと同じディレクトリの spool.lp）
# SWITCHBOT_SPOOL_FILE=/opt/switchbot/spool.lp
# 保存するデータの上限（MB）。超えたら古いものから捨てる
# SWITCHBOT_SPOOL_MAX_MB=50
